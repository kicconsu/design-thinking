diff -ruN a/app/lib/features/projects/ui/viewmodels/project_management_controller.dart b/app/lib/features/projects/ui/viewmodels/project_management_controller.dart
--- a/app/lib/features/projects/ui/viewmodels/project_management_controller.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/app/lib/features/projects/ui/viewmodels/project_management_controller.dart	2026-10-11 03:22:49.760807926 +0000
@@ -0,0 +1,255 @@
+import 'package:get/get.dart';
+
+import 'package:imker/features/auth/ui/viewmodels/authentication_controller.dart';
+import 'package:imker/features/projects/domain/models/project.dart';
+import 'package:imker/features/projects/domain/models/project_task.dart';
+import 'package:imker/features/projects/domain/project_failure.dart';
+import 'package:imker/features/projects/domain/repositories/i_project_repository.dart';
+import 'package:imker/features/projects/ui/viewmodels/user_projects_controller.dart';
+
+/// Panel visible dentro del contenedor de gestión de un proyecto.
+enum ManagementPanel { info, cabinet, task }
+
+/// Estado de la vista de gestión de un proyecto propio: información, gabinete
+/// de tareas y progreso de cada tarea.
+///
+/// Las tareas viven en memoria mientras dure la sesión: todavía no existe una
+/// tabla de tareas en Roble donde persistirlas.
+class ProjectManagementController extends GetxController {
+  final Rxn<Project> selectedProject = Rxn<Project>();
+  final Rx<ManagementPanel> panel = ManagementPanel.info.obs;
+  final RxnString selectedTaskId = RxnString();
+  final RxList<ProjectTask> tasks = <ProjectTask>[].obs;
+  final RxBool isSavingProject = false.obs;
+
+  final Set<String> _seededProjects = {};
+
+  // ─── Navegación ───────────────────────────────────────────────────────────
+
+  void open(Project project) {
+    _seedExampleTask(project.id);
+    panel.value = ManagementPanel.info;
+    selectedTaskId.value = null;
+    selectedProject.value = project;
+  }
+
+  void close() => selectedProject.value = null;
+
+  void showInfo() => panel.value = ManagementPanel.info;
+
+  void showCabinet() {
+    panel.value = ManagementPanel.cabinet;
+  }
+
+  void openTask(String taskId) {
+    selectedTaskId.value = taskId;
+    panel.value = ManagementPanel.task;
+  }
+
+  // ─── Consultas ────────────────────────────────────────────────────────────
+
+  List<ProjectTask> tasksOf(String projectId, TaskStatus status) =>
+      tasks.where((t) => t.projectId == projectId && t.status == status).toList();
+
+  ProjectTask? taskById(String? id) => tasks.firstWhereOrNull((t) => t.id == id);
+
+  List<ProjectTask> _allOf(String projectId) =>
+      tasks.where((t) => t.projectId == projectId).toList();
+
+  /// Porcentaje de finalización del proyecto: promedio del avance de sus tareas.
+  int completionPercent(String projectId) {
+    final all = _allOf(projectId);
+    if (all.isEmpty) return 0;
+    final sum = all.fold<double>(0, (acc, t) => acc + t.progress);
+    return (sum / all.length * 100).round();
+  }
+
+  /// Porcentaje de tareas que están actualmente en progreso.
+  int inProgressPercent(String projectId) {
+    final all = _allOf(projectId);
+    if (all.isEmpty) return 0;
+    final active = all.where((t) => t.status == TaskStatus.inProgress).length;
+    return (active / all.length * 100).round();
+  }
+
+  // ─── Tareas ───────────────────────────────────────────────────────────────
+
+  String get _userName {
+    final name = Get.find<AuthenticationController>().loggedName;
+    return name.isEmpty ? 'Tú' : name;
+  }
+
+  String _newId() => DateTime.now().microsecondsSinceEpoch.toString();
+
+  void createTask({
+    required String projectId,
+    required String title,
+    String description = '',
+  }) {
+    tasks.add(
+      ProjectTask(id: _newId(), projectId: projectId, title: title, description: description),
+    );
+  }
+
+  /// Reserva una tarea pendiente para el usuario activo: pasa a "En progreso".
+  void reserveTask(String taskId) {
+    _update(taskId, (t) => t.copyWith(status: TaskStatus.inProgress, assignee: _userName));
+  }
+
+  /// Guarda descripción y checklist. Si todas las subtareas están hechas la
+  /// tarea queda terminada; si estaba terminada y se desmarca alguna, vuelve a
+  /// "En progreso".
+  void saveTask(String taskId, {required String description, required List<Subtask> subtasks}) {
+    _update(taskId, (t) {
+      final allDone = subtasks.isNotEmpty && subtasks.every((s) => s.done);
+      var status = t.status;
+      if (allDone) {
+        status = TaskStatus.done;
+      } else if (t.status == TaskStatus.done) {
+        status = TaskStatus.inProgress;
+      }
+      return t.copyWith(description: description, subtasks: subtasks, status: status);
+    });
+  }
+
+  void _update(String taskId, ProjectTask Function(ProjectTask) change) {
+    final index = tasks.indexWhere((t) => t.id == taskId);
+    if (index == -1) return;
+    tasks[index] = change(tasks[index]);
+  }
+
+  // ─── Comentarios ──────────────────────────────────────────────────────────
+
+  void addComment(String taskId, String body, {String? parentId}) {
+    final comment = TaskComment(
+      id: _newId(),
+      author: _userName,
+      body: body,
+      createdAt: DateTime.now(),
+      userVote: 1,
+    );
+    _update(taskId, (t) {
+      if (parentId == null) return t.copyWith(comments: [comment, ...t.comments]);
+      return t.copyWith(
+        comments: _mapTree(
+          t.comments,
+          parentId,
+          (c) => c.copyWith(replies: [...c.replies, comment]),
+        ),
+      );
+    });
+  }
+
+  /// Vota un comentario. Votar dos veces igual quita el voto, como en Reddit.
+  void voteComment(String taskId, String commentId, int direction) {
+    _update(taskId, (t) {
+      return t.copyWith(
+        comments: _mapTree(t.comments, commentId, (c) {
+          final next = c.userVote == direction ? 0 : direction;
+          return c.copyWith(score: c.score - c.userVote + next, userVote: next);
+        }),
+      );
+    });
+  }
+
+  List<TaskComment> _mapTree(
+    List<TaskComment> list,
+    String id,
+    TaskComment Function(TaskComment) change,
+  ) => [
+    for (final c in list)
+      if (c.id == id) change(c) else c.copyWith(replies: _mapTree(c.replies, id, change)),
+  ];
+
+  // ─── Información del proyecto ─────────────────────────────────────────────
+
+  /// Guarda la información básica. Devuelve null si salió bien o el mensaje de
+  /// error para mostrar en pantalla.
+  Future<String?> saveProjectInfo({
+    required String title,
+    required String description,
+    required List<String> jobs,
+    required List<String> skills,
+  }) async {
+    final project = selectedProject.value;
+    if (project == null) return 'No hay un proyecto seleccionado.';
+    try {
+      isSavingProject.value = true;
+      await Get.find<IProjectRepository>().updateProject(
+        id: project.id,
+        title: title,
+        description: description,
+        jobs: jobs,
+        skills: skills,
+      );
+      final updated = project.copyWith(
+        title: title,
+        description: description,
+        jobs: jobs,
+        skills: skills,
+      );
+      selectedProject.value = updated;
+      final owned = Get.find<UserProjectsController>().coCreatedProjects;
+      final index = owned.indexWhere((p) => p.id == project.id);
+      if (index != -1) owned[index] = updated;
+      return null;
+    } on ProjectFailure catch (e) {
+      return e.message;
+    } catch (_) {
+      return 'No se pudieron guardar los cambios.';
+    } finally {
+      isSavingProject.value = false;
+    }
+  }
+
+  // ─── Ejemplo ──────────────────────────────────────────────────────────────
+
+  /// Siembra una tarea de ejemplo (la del prototipo de Figma) la primera vez
+  /// que se abre un proyecto, hasta que exista una tabla de tareas real.
+  void _seedExampleTask(String projectId) {
+    if (!_seededProjects.add(projectId)) return;
+    if (_allOf(projectId).isNotEmpty) return;
+    final now = DateTime.now();
+    tasks.add(
+      ProjectTask(
+        id: 'example-$projectId',
+        projectId: projectId,
+        title: 'Implementación Roble para autenticación',
+        description:
+            'Integrar el SDK de Roble para el inicio de sesión, el registro y el manejo de la sesión del usuario.',
+        subtasks: const [
+          Subtask(title: 'Importar librerías', done: true),
+          Subtask(title: 'Implementar GET', done: true),
+          Subtask(title: 'Implementar POST'),
+          Subtask(title: 'Implementar PUT'),
+          Subtask(title: 'Implementar DELETE'),
+        ],
+        comments: [
+          TaskComment(
+            id: 'example-c1',
+            author: 'Laura Gómez',
+            body: '¿Ya definimos qué tablas vamos a necesitar para esto?',
+            createdAt: now.subtract(const Duration(hours: 5)),
+            score: 4,
+            replies: [
+              TaskComment(
+                id: 'example-c1-r1',
+                author: 'Pedro Jiménez',
+                body: 'Por ahora solo user_system y profile. Lo demás lo vemos en la reunión.',
+                createdAt: now.subtract(const Duration(hours: 3)),
+                score: 2,
+              ),
+            ],
+          ),
+          TaskComment(
+            id: 'example-c2',
+            author: 'Alberto Mendoza',
+            body: 'Recuerden manejar el refresh del token antes de hacer las pruebas.',
+            createdAt: now.subtract(const Duration(days: 1)),
+            score: 7,
+          ),
+        ],
+      ),
+    );
+  }
+}
diff -ruN a/app/lib/features/projects/ui/widgets/management/checklist_editor.dart b/app/lib/features/projects/ui/widgets/management/checklist_editor.dart
--- a/app/lib/features/projects/ui/widgets/management/checklist_editor.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/app/lib/features/projects/ui/widgets/management/checklist_editor.dart	2026-10-11 03:22:49.761072724 +0000
@@ -0,0 +1,124 @@
+import 'package:flutter/material.dart';
+
+/// Un ítem de [ChecklistEditor]: texto más si está marcado.
+class ChecklistEntry {
+  const ChecklistEntry(this.label, {this.checked = true});
+
+  final String label;
+  final bool checked;
+
+  ChecklistEntry copyWith({bool? checked}) =>
+      ChecklistEntry(label, checked: checked ?? this.checked);
+}
+
+/// Campo para añadir ítems más la lista de ítems con casilla de verificación.
+///
+/// Mantiene su propia lista y avisa de cada cambio con [onChanged]; el padre
+/// decide qué hacer con ella al guardar.
+class ChecklistEditor extends StatefulWidget {
+  const ChecklistEditor({
+    super.key,
+    required this.initial,
+    required this.hint,
+    required this.onChanged,
+    this.addedChecked = true,
+  });
+
+  final List<ChecklistEntry> initial;
+  final String hint;
+  final ValueChanged<List<ChecklistEntry>> onChanged;
+
+  /// Si los ítems recién añadidos nacen marcados.
+  final bool addedChecked;
+
+  @override
+  State<ChecklistEditor> createState() => _ChecklistEditorState();
+}
+
+class _ChecklistEditorState extends State<ChecklistEditor> {
+  final _input = TextEditingController();
+  late List<ChecklistEntry> _items = List.of(widget.initial);
+
+  @override
+  void dispose() {
+    _input.dispose();
+    super.dispose();
+  }
+
+  void _emit() => widget.onChanged(List.unmodifiable(_items));
+
+  void _add() {
+    final value = _input.text.trim();
+    if (value.isEmpty) return;
+    final exists = _items.any((e) => e.label.toLowerCase() == value.toLowerCase());
+    if (!exists) {
+      setState(() => _items = [..._items, ChecklistEntry(value, checked: widget.addedChecked)]);
+      _emit();
+    }
+    _input.clear();
+  }
+
+  void _toggle(int index, bool checked) {
+    setState(() => _items[index] = _items[index].copyWith(checked: checked));
+    _emit();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final cs = Theme.of(context).colorScheme;
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Row(
+          children: [
+            Expanded(
+              child: TextField(
+                controller: _input,
+                onSubmitted: (_) => _add(),
+                decoration: InputDecoration(
+                  hintText: widget.hint,
+                  isDense: true,
+                  filled: true,
+                  fillColor: cs.surface,
+                  border: OutlineInputBorder(
+                    borderRadius: BorderRadius.zero,
+                    borderSide: BorderSide(color: cs.outline),
+                  ),
+                ),
+              ),
+            ),
+            const SizedBox(width: 8),
+            FilledButton(
+              style: FilledButton.styleFrom(
+                shape: const RoundedRectangleBorder(borderRadius: BorderRadius.zero),
+              ),
+              onPressed: _add,
+              child: const Text('Añadir'),
+            ),
+          ],
+        ),
+        const SizedBox(height: 8),
+        for (var i = 0; i < _items.length; i++)
+          Container(
+            margin: const EdgeInsets.only(bottom: 6),
+            decoration: BoxDecoration(
+              color: cs.secondaryContainer,
+              border: Border.all(color: cs.outline),
+            ),
+            child: CheckboxListTile(
+              dense: true,
+              visualDensity: VisualDensity.compact,
+              controlAffinity: ListTileControlAffinity.trailing,
+              value: _items[i].checked,
+              onChanged: (v) => _toggle(i, v ?? false),
+              title: Text(
+                _items[i].label,
+                style: TextStyle(color: cs.onSecondaryContainer),
+              ),
+            ),
+          ),
+      ],
+    );
+  }
+}
diff -ruN a/app/lib/features/projects/ui/widgets/management/management_panel_frame.dart b/app/lib/features/projects/ui/widgets/management/management_panel_frame.dart
--- a/app/lib/features/projects/ui/widgets/management/management_panel_frame.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/app/lib/features/projects/ui/widgets/management/management_panel_frame.dart	2026-10-11 03:22:49.760993728 +0000
@@ -0,0 +1,97 @@
+import 'package:flutter/material.dart';
+
+/// Marco común de los paneles del contenedor de gestión: fondo opaco (para
+/// tapar lo que hay debajo mientras se desliza), título, pestañas opcionales,
+/// contenido que se desplaza y un botón fijo abajo.
+class ManagementPanelFrame extends StatelessWidget {
+  const ManagementPanelFrame({
+    super.key,
+    required this.title,
+    this.onBack,
+    this.tabs,
+    required this.body,
+    this.bottom,
+  });
+
+  final String title;
+  final VoidCallback? onBack;
+
+  /// Selector de pestañas que va bajo el título.
+  final Widget? tabs;
+  final Widget body;
+
+  /// Botón (o barra) fijo en la parte inferior.
+  final Widget? bottom;
+
+  @override
+  Widget build(BuildContext context) {
+    final cs = Theme.of(context).colorScheme;
+    final tt = Theme.of(context).textTheme;
+
+    return ColoredBox(
+      color: cs.primaryContainer,
+      child: Column(
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(4, 8, 4, 0),
+            child: Row(
+              children: [
+                SizedBox(
+                  width: 48,
+                  child: onBack == null
+                      ? null
+                      : IconButton(
+                          tooltip: 'Volver',
+                          icon: const Icon(Icons.arrow_back),
+                          onPressed: onBack,
+                        ),
+                ),
+                Expanded(
+                  child: Text(
+                    title,
+                    textAlign: TextAlign.center,
+                    style: tt.titleLarge?.copyWith(fontWeight: FontWeight.bold),
+                  ),
+                ),
+                const SizedBox(width: 48),
+              ],
+            ),
+          ),
+          if (tabs != null)
+            Padding(padding: const EdgeInsets.fromLTRB(12, 8, 12, 0), child: tabs),
+          Expanded(
+            child: SingleChildScrollView(
+              padding: const EdgeInsets.all(12),
+              child: body,
+            ),
+          ),
+          if (bottom != null)
+            Padding(padding: const EdgeInsets.fromLTRB(12, 0, 12, 12), child: bottom),
+        ],
+      ),
+    );
+  }
+}
+
+/// Botón de acción a todo el ancho con las esquinas cuadradas del diseño.
+class PanelButton extends StatelessWidget {
+  const PanelButton({super.key, required this.label, required this.onPressed, this.busy = false});
+
+  final String label;
+  final VoidCallback? onPressed;
+  final bool busy;
+
+  @override
+  Widget build(BuildContext context) {
+    return FilledButton(
+      style: FilledButton.styleFrom(
+        minimumSize: const Size.fromHeight(46),
+        shape: const RoundedRectangleBorder(borderRadius: BorderRadius.zero),
+      ),
+      onPressed: busy ? null : onPressed,
+      child: busy
+          ? const SizedBox(width: 20, height: 20, child: CircularProgressIndicator(strokeWidth: 2))
+          : Text(label),
+    );
+  }
+}
diff -ruN a/app/lib/features/projects/ui/widgets/management/project_info_panel.dart b/app/lib/features/projects/ui/widgets/management/project_info_panel.dart
--- a/app/lib/features/projects/ui/widgets/management/project_info_panel.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/app/lib/features/projects/ui/widgets/management/project_info_panel.dart	2026-10-11 03:22:49.761009948 +0000
@@ -0,0 +1,257 @@
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+
+import 'package:imker/core/widgets/score_gauge.dart';
+import 'package:imker/core/widgets/segmented_tab_switch.dart';
+import 'package:imker/features/projects/domain/models/project.dart';
+import 'package:imker/features/projects/ui/viewmodels/project_management_controller.dart';
+import 'checklist_editor.dart';
+import 'management_panel_frame.dart';
+
+/// Panel "Información de Proyecto": progreso, información básica y miembros.
+class ProjectInfoPanel extends StatefulWidget {
+  const ProjectInfoPanel({super.key, required this.project});
+
+  final Project project;
+
+  @override
+  State<ProjectInfoPanel> createState() => _ProjectInfoPanelState();
+}
+
+class _ProjectInfoPanelState extends State<ProjectInfoPanel> {
+  int _tab = 0; // 0: Progreso, 1: Info. básica, 2: Miembros
+
+  final _title = TextEditingController();
+  final _description = TextEditingController();
+  late List<ChecklistEntry> _jobs;
+  late List<ChecklistEntry> _skills;
+
+  @override
+  void initState() {
+    super.initState();
+    _title.text = widget.project.title;
+    _description.text = widget.project.description;
+    _jobs = [for (final j in widget.project.jobs) ChecklistEntry(j)];
+    _skills = [for (final s in widget.project.skills) ChecklistEntry(s)];
+  }
+
+  @override
+  void dispose() {
+    _title.dispose();
+    _description.dispose();
+    super.dispose();
+  }
+
+  Future<void> _save() async {
+    final title = _title.text.trim();
+    if (title.isEmpty) {
+      Get.snackbar('Falta el nombre', 'El proyecto necesita un nombre.',
+          snackPosition: SnackPosition.BOTTOM);
+      return;
+    }
+    // Las casillas desmarcadas se descartan al guardar.
+    final error = await Get.find<ProjectManagementController>().saveProjectInfo(
+      title: title,
+      description: _description.text.trim(),
+      jobs: [for (final e in _jobs) if (e.checked) e.label],
+      skills: [for (final e in _skills) if (e.checked) e.label],
+    );
+    Get.snackbar(
+      error == null ? 'Listo' : 'Error',
+      error ?? 'Los cambios del proyecto se guardaron.',
+      snackPosition: SnackPosition.BOTTOM,
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final controller = Get.find<ProjectManagementController>();
+
+    return ManagementPanelFrame(
+      title: 'Información de Proyecto',
+      tabs: SegmentedTabSwitch(
+        tabs: const ['Progreso', 'Info. básica', 'Miembros'],
+        selectedIndex: _tab,
+        onTabSelected: (i) => setState(() => _tab = i),
+      ),
+      body: switch (_tab) {
+        0 => _ProgressTab(projectId: widget.project.id),
+        1 => _BasicInfoTab(
+          title: _title,
+          description: _description,
+          jobs: _jobs,
+          skills: _skills,
+          onJobsChanged: (v) => _jobs = v,
+          onSkillsChanged: (v) => _skills = v,
+        ),
+        _ => _MembersTab(members: widget.project.members),
+      },
+      bottom: switch (_tab) {
+        0 => PanelButton(label: 'Ver Tareas', onPressed: controller.showCabinet),
+        1 => Obx(
+          () => PanelButton(
+            label: 'Guardar Cambios',
+            busy: controller.isSavingProject.value,
+            onPressed: _save,
+          ),
+        ),
+        _ => null,
+      },
+    );
+  }
+}
+
+class _ProgressTab extends StatelessWidget {
+  const _ProgressTab({required this.projectId});
+
+  final String projectId;
+
+  // Todavía no hay fechas límite en las tareas, así que "Entregas a tiempo"
+  // es un valor fijo, igual que los indicadores de confianza del perfil.
+  static const _onTimePlaceholder = 83;
+
+  @override
+  Widget build(BuildContext context) {
+    final controller = Get.find<ProjectManagementController>();
+    final cs = Theme.of(context).colorScheme;
+    final tt = Theme.of(context).textTheme;
+
+    return Obx(() {
+      final completion = controller.completionPercent(projectId);
+      final inProgress = controller.inProgressPercent(projectId);
+
+      return Container(
+        padding: const EdgeInsets.all(12),
+        decoration: BoxDecoration(color: cs.surface, border: Border.all(color: cs.outline)),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text('Progreso general', style: tt.titleMedium?.copyWith(fontWeight: FontWeight.bold)),
+            const SizedBox(height: 12),
+            Row(
+              children: [
+                Expanded(child: Text('Porcentaje de Finalización', style: tt.bodyMedium)),
+                Text('$completion%', style: tt.bodyMedium?.copyWith(fontWeight: FontWeight.bold)),
+              ],
+            ),
+            const SizedBox(height: 4),
+            LinearProgressIndicator(
+              value: completion / 100,
+              minHeight: 8,
+              backgroundColor: cs.surfaceContainerHighest,
+              color: cs.primary,
+            ),
+            const SizedBox(height: 20),
+            Row(
+              mainAxisAlignment: MainAxisAlignment.spaceEvenly,
+              children: [
+                ScoreGauge(label: 'Tareas en Progreso', value: inProgress),
+                const ScoreGauge(label: 'Entregas a Tiempo', value: _onTimePlaceholder),
+              ],
+            ),
+          ],
+        ),
+      );
+    });
+  }
+}
+
+class _BasicInfoTab extends StatelessWidget {
+  const _BasicInfoTab({
+    required this.title,
+    required this.description,
+    required this.jobs,
+    required this.skills,
+    required this.onJobsChanged,
+    required this.onSkillsChanged,
+  });
+
+  final TextEditingController title;
+  final TextEditingController description;
+  final List<ChecklistEntry> jobs;
+  final List<ChecklistEntry> skills;
+  final ValueChanged<List<ChecklistEntry>> onJobsChanged;
+  final ValueChanged<List<ChecklistEntry>> onSkillsChanged;
+
+  @override
+  Widget build(BuildContext context) {
+    final cs = Theme.of(context).colorScheme;
+    final tt = Theme.of(context).textTheme;
+
+    InputDecoration box([String? hint]) => InputDecoration(
+      hintText: hint,
+      filled: true,
+      fillColor: cs.surface,
+      border: OutlineInputBorder(
+        borderRadius: BorderRadius.zero,
+        borderSide: BorderSide(color: cs.outline),
+      ),
+    );
+
+    Widget label(String text) => Padding(
+      padding: const EdgeInsets.only(top: 14, bottom: 6),
+      child: Text(text, style: tt.titleSmall?.copyWith(fontWeight: FontWeight.bold)),
+    );
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text('Nombre del proyecto', style: tt.titleSmall?.copyWith(fontWeight: FontWeight.bold)),
+        const SizedBox(height: 6),
+        TextField(controller: title, decoration: box()),
+        label('Descripción'),
+        TextField(controller: description, minLines: 3, maxLines: 6, decoration: box()),
+        label('Carreras relacionadas'),
+        ChecklistEditor(
+          initial: jobs,
+          hint: 'Escribe una carrera relacionada',
+          onChanged: onJobsChanged,
+        ),
+        label('Conocimientos requeridos'),
+        ChecklistEditor(
+          initial: skills,
+          hint: 'Añade una habilidad',
+          onChanged: onSkillsChanged,
+        ),
+      ],
+    );
+  }
+}
+
+class _MembersTab extends StatelessWidget {
+  const _MembersTab({required this.members});
+
+  final List<String> members;
+
+  @override
+  Widget build(BuildContext context) {
+    final cs = Theme.of(context).colorScheme;
+    final tt = Theme.of(context).textTheme;
+
+    if (members.isEmpty) {
+      return Text('Este proyecto todavía no tiene miembros.', style: tt.bodyMedium);
+    }
+
+    return Column(
+      children: [
+        for (final name in members)
+          Container(
+            margin: const EdgeInsets.only(bottom: 8),
+            padding: const EdgeInsets.all(10),
+            decoration: BoxDecoration(color: cs.surface, border: Border.all(color: cs.outline)),
+            child: Row(
+              children: [
+                CircleAvatar(
+                  radius: 18,
+                  backgroundColor: cs.tertiaryContainer,
+                  child: Icon(Icons.person, size: 20, color: cs.onTertiaryContainer),
+                ),
+                const SizedBox(width: 12),
+                Expanded(child: Text(name, style: tt.bodyLarge)),
+              ],
+            ),
+          ),
+      ],
+    );
+  }
+}
