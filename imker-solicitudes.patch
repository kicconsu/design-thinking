+            ),
+            const SizedBox(height: 4),
+            Align(
+              alignment: Alignment.centerRight,
+              child: Text(
+                'Compromiso ${applicant.commitmentScore}%',
+                style: tt.bodySmall,
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
